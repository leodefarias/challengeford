# ── LLM ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                    # não usado pelo chat atual
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...                 # obrigatório para chat e extração
FIRECRAWL_API_KEY=                    # opcional (melhora scraping JS)

# ── Oracle FIAP ──────────────────────────────────────────────────────
ORACLE_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521/ORCL
ORACLE_USER=SEU_RM_AQUI               # ex: RM555211
ORACLE_PASSWORD=SUA_SENHA_ORACLE      # senha do seu usuário Oracle FIAP

# ── Segurança ────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 64
JWT_SECRET=

# AES-256 key para criptografia em repouso (dados sensíveis no Oracle)
# Gerar com: openssl rand -base64 32
ENCRYPTION_KEY=

# Chave interna entre Java API <-> Python IA
# Gerar com: openssl rand -hex 32
INTERNAL_API_KEY=

# URL do Python service (não alterar para Docker)
PYTHON_SERVICE_URL=http://localhost:8000

# CORS — origem do mobile/browser
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Senha do admin padrão (só cria o usuário se o e-mail ainda não existir no Oracle).
FORD_ADMIN_PASSWORD=Ford@2025
