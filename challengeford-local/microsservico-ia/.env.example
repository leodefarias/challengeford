OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MODEL_FALLBACK=gpt-4.1
LLM_PROVIDER=openai

# Chave interna Java API <-> Python (mesmo valor do .env da raiz)
INTERNAL_API_KEY=

CHROMA_PERSIST_DIR=data/chromadb
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

