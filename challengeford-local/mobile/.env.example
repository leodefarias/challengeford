# URL da API Java.
# Docker (via Nginx TLS): EXPO_PUBLIC_API_URL=https://localhost
# Desenvolvimento local (Spring Boot direto): EXPO_PUBLIC_API_URL=http://localhost:8080
# Demo pública (./start.sh --demo): EXPO_PUBLIC_API_URL=same-origin  (mesmo host do túnel)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Só o export da demo (não ligue no dia a dia)
# EXPO_PUBLIC_DEMO=1
